PORT=3000

# Chat model. llm.js is written against the generic OpenAI-compatible
# chat completions shape, which many providers and gateways support, so
# swapping provider means changing these values only - never the code.
# Instructors: the provider choice (and who pays for keys) is made per
# cohort - see the week's plan.md.
LLM_API_BASE=https://api.example-provider.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-chat-model-name

# Embeddings (Day 3). "local" (the default) runs a small open model on
# your machine - no key, no cost. Set to "api" to use your provider's
# /embeddings endpoint instead, and fill in LLM_EMBED_MODEL.
EMBED_PROVIDER=local
LLM_EMBED_MODEL=
