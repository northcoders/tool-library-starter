# Chat model. llm.py is written against the generic OpenAI-compatible
# chat completions shape, which many providers and gateways support, so
# swapping provider means changing these values only - never the code.
# This course uses NVIDIA's free tier (build.nvidia.com): each learner
# makes their own free key and pastes it below. Instructors: the provider
# choice is made per cohort - see the week's SETUP-GUIDE.md.
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional. Some models spend tokens and time on hidden "thinking" before
# they answer; "none" switches that off on providers that support it.
# Leave it blank for a provider that doesn't.
LLM_REASONING_EFFORT=none

# Embeddings (Day 3). "local" (the default) runs a small open model on
# your machine - no key, no cost. Set to "api" to use your provider's
# /embeddings endpoint instead, and fill in LLM_EMBED_MODEL.
EMBED_PROVIDER=local
LLM_EMBED_MODEL=
